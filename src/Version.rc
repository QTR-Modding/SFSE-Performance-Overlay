#include <winver.h>

1 VERSIONINFO
FILEVERSION OVERLAY_VERSION_MAJOR, OVERLAY_VERSION_MINOR, OVERLAY_VERSION_PATCH, 0
PRODUCTVERSION OVERLAY_VERSION_MAJOR, OVERLAY_VERSION_MINOR, OVERLAY_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", OVERLAY_NAME
            VALUE "FileVersion", OVERLAY_VERSION_TEXT
            VALUE "InternalName", OVERLAY_NAME
            VALUE "LegalCopyright", OVERLAY_AUTHOR
            VALUE "ProductName", OVERLAY_NAME
            VALUE "ProductVersion", OVERLAY_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
